{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Edit(./saidas/**)",
      "Edit(./estado/**)",
      "Edit(./cerebro/memoria/propostas.md)",
      "Edit(./DIARIO.md)",
      "Bash(node scripts/resumo-log.mjs *)",
      "Bash(node scripts/custo.mjs *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pausa.mjs\"" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-perigoso.mjs\"" } ] },
      { "matcher": "Agent", "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-eventos.mjs\"" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-eventos.mjs\"" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-eventos.mjs\"" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-eventos.mjs\"" } ] }
    ]
  },
  "sandbox": { "enabled": true, "network": { "allowLocalBinding": true } }
}
